; TriVM 能力演示 — 系统化展示所有指令
; 寄存器约定: R5 = 0 (用于 MOV 模拟)
.text
  LDI   R5, 0

  ; === 0. 欢迎 ===
  LDI   R0, s_hello
  LDI   R1, 7          ; PRINT_S
  SYSCALL R1

  ; === 1. 算术 (3+5)*2-4=12 ===
  LDI   R0, s_arith
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 3
  LDI   R1, 5
  LDI   R2, 2
  LDI   R3, 4
  ADD   R4, R0, R1     ; R4 = 8
  MUL   R4, R4, R2     ; R4 = 16
  SUB   R4, R4, R3     ; R4 = 12
  ADD   R0, R4, R5     ; R0 = 12 (MOV via R5=0)
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1

  ; === 2. 除法 10/3=3 r=1 ===
  LDI   R0, s_div
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 10
  LDI   R1, 3
  DIV   R2, R0, R1
  MOD   R3, R0, R1
  ADD   R0, R2, R5
  LDI   R1, 3
  SYSCALL R1
  LDI   R0, s_r
  LDI   R1, 7
  SYSCALL R1
  ADD   R0, R3, R5
  LDI   R1, 3
  SYSCALL R1

  ; === 3. MAC 乘累加: 1*4+2*5+3*6=32 ===
  LDI   R0, s_mac
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 0
  LDI   R1, 1
  LDI   R2, 4
  MAC   R0, R1, R2     ; 4
  LDI   R1, 2
  LDI   R2, 5
  MAC   R0, R1, R2     ; 14
  LDI   R1, 3
  LDI   R2, 6
  MAC   R0, R1, R2     ; 32
  LDI   R1, 3
  SYSCALL R1

  ; === 4. 循环 + 条件分支 ===
  LDI   R0, s_loop
  LDI   R1, 7
  SYSCALL R1
  LDI   R3, 3
l_start:
  BZ   R3, l_done
  ADD   R0, R3, R5
  LDI   R1, 3
  SYSCALL R1           ; 打印 3 2 1
  LDI   R0, 32
  LDI   R1, 4          ; PRINT_C (' ')
  SYSCALL R1
  ADDI  R3, R3, -1
  JMP   l_start
l_done:
  LDI   R0, 10
  LDI   R1, 4          ; PRINT_C (\n)
  SYSCALL R1

  ; === 5. 子程序: 4! = 24 ===
  LDI   R0, s_fact
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 4
  CALL  factorial
  LDI   R1, 3
  SYSCALL R1

  ; === 6. 内存: 存99到mem[50], 再读回 ===
  LDI   R0, s_mem
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 99
  LDI   R1, 50
  ST    R0, R1, 0
  LD    R0, R1, 0
  LDI   R1, 3
  SYSCALL R1

  ; === 7. 平衡三进制: 42 = 1T1T0 ===
  LDI   R0, s_tern
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 42
  LDI   R1, 2          ; PRINT_T
  SYSCALL R1

  ; === 8. 溢出饱和: 364+1=364 ov=1 ===
  LDI   R0, s_ovf
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 364
  LDI   R1, 1
  ADD   R0, R0, R1     ; 饱和到 364, R7=1
  LDI   R1, 3
  SYSCALL R1
  LDI   R0, 32
  LDI   R1, 4          ; PRINT_C (' ')
  SYSCALL R1
  ADD   R0, R7, R5
  LDI   R1, 3
  SYSCALL R1           ; 打印溢出标志

  ; === 9. 结束 ===
  LDI   R0, s_done
  LDI   R1, 7
  SYSCALL R1
  LDI   R1, 1          ; EXIT
  SYSCALL R1

; ─── 阶乘: R0 = n, 返回 R0 = n! ───
factorial:
  LDI   R6, 1
f_loop:
  ADDI  R2, R0, -1
  BZ    R2, f_done
  BN    R2, f_done
  MUL   R6, R6, R0
  ADDI  R0, R0, -1
  JMP   f_loop
f_done:
  MUL   R0, R6, R0
  RET

.data
s_hello: .asciiz "\n=== TriVM Demo ===\n"
s_arith: .asciiz "\n1.Arith="
s_div:   .asciiz "\n2.Div="
s_r:     .asciiz " r="
s_mac:   .asciiz "\n3.MAC="
s_loop:  .asciiz "\n4.Loop: "
s_fact:  .asciiz "\n5.Fact="
s_mem:   .asciiz "\n6.Mem="
s_tern:  .asciiz "\n7.Tern="
s_ovf:   .asciiz "\n8.Ovf="
s_done:  .asciiz "\n=== Done ===\n"
