; ============================================================
; TriVM 能力演示 — 系统化展示所有指令和特性
; ============================================================
; 用法: cargo run -- examples/demo.tri
; ============================================================

.text

  ; ─── 1. 欢迎消息 ───
  LDI   R0, msg_hello
  LDI   R1, 7          ; PRINT_S
  SYSCALL R1

  ; ─── 2. 算术演示:  (3 + 5) × 2 - 4 = 12 ───
  LDI   R0, 3
  LDI   R1, 5
  LDI   R2, 2
  LDI   R3, 4
  ADD   R4, R0, R1     ; R4 = 3 + 5 = 8
  MUL   R4, R4, R2     ; R4 = 8 × 2 = 16
  SUB   R4, R4, R3     ; R4 = 16 - 4 = 12
  ; 输出: "12"
  LDI   R0, msg_arith
  LDI   R1, 7          ; PRINT_S
  SYSCALL R1
  MOV   R0, R4
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1

  ; ─── 3. 除法与取模: 10 ÷ 3 = 3 ... 1 ───
  LDI   R0, msg_div
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 10
  LDI   R1, 3
  DIV   R2, R0, R1     ; R2 = 10 / 3 = 3
  MOD   R3, R0, R1     ; R3 = 10 % 3 = 1
  ; 输出: "3"
  MOV   R0, R2
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1
  ; 输出: " r "
  LDI   R0, msg_r
  LDI   R1, 7
  SYSCALL R1
  ; 输出: "1"
  MOV   R0, R3
  LDI   R1, 3
  SYSCALL R1

  ; ─── 4. 比较指令: CMP 和 SGN ───
  LDI   R0, msg_cmp
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 7
  LDI   R1, 3
  CMP   R2, R0, R1     ; R2 = sgn(7-3) = 1
  ; 输出: "cmp(7,3)="
  LDI   R0, msg_cmp_73
  LDI   R1, 7
  SYSCALL R1
  MOV   R0, R2
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1

  ; SGN: sgn(-5) = -1
  LDI   R0, msg_sgn
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, -5
  SGN   R0, R0         ; R0 = sgn(-5) = -1
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1

  ; ─── 5. MAC 乘累加: 点积 [1,2,3]·[4,5,6] = 32 ───
  LDI   R0, msg_mac
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 0          ; sum = 0
  MAC   R0, R1, R2     ; (R1,R2 not set yet = 0) → 0
  LDI   R1, 1
  LDI   R2, 4
  MAC   R0, R1, R2     ; sum += 1×4 = 4
  LDI   R1, 2
  LDI   R2, 5
  MAC   R0, R1, R2     ; sum += 2×5 = 14
  LDI   R1, 3
  LDI   R2, 6
  MAC   R0, R1, R2     ; sum += 3×6 = 32
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1

  ; ─── 6. 条件分支: 循环计数 5→0 ───
  LDI   R0, msg_loop
  LDI   R1, 7
  SYSCALL R1
  LDI   R4, 5          ; counter = 5
loop_start:
  BZ   R4, loop_done
  MOV   R0, R4
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1
  ; 输出空格
  LDI   R0, 32         ; ' '
  LDI   R1, 4          ; PRINT_C
  SYSCALL R1
  ADDI  R4, R4, -1
  JMP   loop_start
loop_done:
  ; 换行
  LDI   R0, 10         ; '\n'
  LDI   R1, 4
  SYSCALL R1

  ; ─── 7. 子程序调用: 阶乘 5! = 120 ───
  LDI   R0, msg_fact
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 5
  CALL  factorial
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1

  ; ─── 8. 内存操作: 写入并读回 ───
  LDI   R0, msg_mem
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 42
  LDI   R1, 100        ; 地址 100
  ST    R0, R1, 0      ; mem[100] = 42
  LD    R0, R1, 0      ; R0 = mem[100] = 42
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1

  ; ─── 9. 平衡三进制输出 ───
  LDI   R0, msg_tern
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 42         ; 42 = 1T1T0 (平衡三进制)
  LDI   R1, 2          ; PRINT_T
  SYSCALL R1

  ; ─── 10. 溢出饱和演示 ───
  LDI   R0, msg_ovf
  LDI   R1, 7
  SYSCALL R1
  LDI   R0, 364        ; Tryte 最大值
  LDI   R1, 1
  ADD   R0, R0, R1     ; 364 + 1 → 饱和到 364, R7=1
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1            ; 输出 "364"
  ; 输出 " ov="
  LDI   R0, msg_ov
  LDI   R1, 7
  SYSCALL R1
  MOV   R0, R7         ; R7 = 溢出标志
  LDI   R1, 3          ; PRINT_D
  SYSCALL R1            ; 输出 "1"

  ; ─── 结束 ───
  LDI   R0, msg_done
  LDI   R1, 7
  SYSCALL R1
  LDI   R1, 1          ; EXIT
  SYSCALL R1

; ─── 子程序: 阶乘 ───
factorial:
  CMP   R2, R0, R1     ; R2 = sgn(R0 - 1)
  BP    R2, do_fact    ; if R0 > 1 → compute
  LDI   R0, 1          ; R0 <= 1 → return 1
  RET
do_fact:
  ; 保存返回地址和 R0
  CALL  fact_recurse
  RET
fact_recurse:
  ; R0 = n, compute n * factorial(n-1)
  MOV   R6, R0         ; save n
  ADDI  R0, R0, -1     ; R0 = n-1
  CALL  factorial
  MUL   R0, R6, R0     ; R0 = n * factorial(n-1)
  RET

; ─── 字符串数据 ───
.data
msg_hello:  .asciiz "\n=== TriVM 能力演示 ===\n\n"
msg_arith:  .asciiz "[算术] (3+5)*2-4 = "
msg_div:    .asciiz "\n[除法] 10/3 = "
msg_r:      .asciiz " r "
msg_cmp:    .asciiz "\n[比较] "
msg_cmp_73: .asciiz "cmp(7,3)="
msg_sgn:    .asciiz "\n[符号] sgn(-5)="
msg_mac:    .asciiz "\n[MAC]  [1,2,3]·[4,5,6]="
msg_loop:   .asciiz "\n[循环] countdown: "
msg_fact:   .asciiz "\n[子程序] 5! = "
msg_mem:    .asciiz "\n[内存] mem[100] ← → "
msg_tern:   .asciiz "\n[三进制] 42 = "
msg_ovf:    .asciiz "\n[溢出] 364+1="
msg_ov:     .asciiz " ov="
msg_done:   .asciiz "\n\n=== 演示结束 ===\n"
